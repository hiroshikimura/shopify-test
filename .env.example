# Shopify Dev Dashboard (または Partner Dashboard) で作成したアプリの Client ID / Client secret
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Shopify から到達できる公開URL。末尾スラッシュなし
HOST=https://dev.example.com
# shopify.app.<名前>.toml の access_scopes と揃える
SCOPES=read_products
# /logs の Basic 認証のパスワード（ユーザー名は任意）。未設定だと /logs は誰も見られない
# 生成例: ruby -rsecurerandom -e 'puts SecureRandom.hex(16)'
LOGS_TOKEN=
# 1 にするとインストール時などのトークン交換で有期限のオフライントークン (expiring: 1) を要求する。未設定なら無期限
SHOPIFY_EXPIRING_OFFLINE_TOKENS=
