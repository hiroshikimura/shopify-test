<h1>Shopify Test</h1>
<p class="muted">
  ショップ: <strong><%= @shop_origin %></strong> /
  API version: <%= ShopifyApp.configuration.api_version %> /
  scopes: <%= ShopifyApp.configuration.scope %>
</p>

<section class="card">
  <h2>オフライントークン</h2>
  <table class="meta">
    <tr><th>種類</th><td id="token-kind"><%= @shop&.expires_at ? "有期限" : "無期限" %></td></tr>
    <tr><th>有効期限</th><td id="token-expires"><%= @shop&.expires_at&.strftime("%Y-%m-%d %H:%M:%S") || "-" %></td></tr>
    <tr><th>リフレッシュトークン期限</th><td id="token-refresh-expires"><%= @shop&.refresh_token_expires_at&.strftime("%Y-%m-%d %H:%M:%S") || "-" %></td></tr>
    <tr><th>インストール時の要求</th><td><%= ShopifyAPI::Context.expiring_offline_access_tokens ? "有期限" : "無期限" %>（SHOPIFY_EXPIRING_OFFLINE_TOKENS）</td></tr>
  </table>
  <% if @shop %>
    <div id="migrate-box" data-expiring="<%= @shop.expires_at.present? %>">
      <p class="error" id="migrate-note"></p>
      <label><input type="checkbox" id="migrate-ack"> <span id="migrate-ack-label"></span></label>
      <button type="button" id="migrate" class="primary" disabled></button>
      <pre id="migrate-result" class="code" hidden></pre>
    </div>
  <% end %>
</section>

<section class="card">
  <h2>Admin GraphQL API を叩く</h2>
  <div class="buttons">
    <button type="button" data-sample="shop">shop</button>
    <button type="button" data-sample="products">products</button>
    <button type="button" data-sample="scopes">付与済みスコープ</button>
    <button type="button" data-sample="webhooks">Webhook 登録状況</button>
  </div>
  <textarea id="query" rows="8" spellcheck="false"></textarea>
  <button type="button" id="run" class="primary">実行</button>
  <pre id="result" class="code">（結果がここに表示されます）</pre>
</section>

<section class="card">
  <h2>
    最近の通信
    <button type="button" id="reload-logs">更新</button>
  </h2>
  <p class="muted">
    詳細（ヘッダー・ボディ・JWTの中身）は
    <a href="http://localhost:<%= ENV.fetch("PORT", 3000) %>/logs" target="_blank" rel="noopener">http://localhost:<%= ENV.fetch("PORT", 3000) %>/logs</a>
    で確認できます（ローカルからのみアクセス可）。
  </p>
  <table class="logs">
    <thead><tr><th>#</th><th>時刻</th><th>方向</th><th>種別</th><th>メソッド</th><th>URL</th><th>status</th><th>ms</th></tr></thead>
    <tbody id="logs">
      <% @logs.each do |log| %>
        <tr>
          <td><%= log.id %></td>
          <td><%= log.created_at.strftime("%H:%M:%S") %></td>
          <td><%= log.inbound? ? "← in" : "→ out" %></td>
          <td><%= log.category %></td>
          <td><%= log.http_method %></td>
          <td class="url"><%= log.url.truncate(100) %></td>
          <td><%= log.status || log.error %></td>
          <td><%= log.duration_ms %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>

<script>
  const samples = {
    shop: `{
  shop {
    name
    email
    myshopifyDomain
    currencyCode
    plan { displayName }
  }
}`,
    products: `{
  products(first: 5, sortKey: UPDATED_AT, reverse: true) {
    nodes { id title status updatedAt }
  }
}`,
    scopes: `{
  currentAppInstallation {
    accessScopes { handle }
  }
}`,
    webhooks: `{
  webhookSubscriptions(first: 20) {
    nodes {
      id
      topic
      endpoint { ... on WebhookHttpEndpoint { callbackUrl } }
    }
  }
}`,
  };

  const queryEl = document.getElementById("query");
  const resultEl = document.getElementById("result");
  queryEl.value = samples.shop;

  document.querySelectorAll("[data-sample]").forEach((button) => {
    button.addEventListener("click", () => { queryEl.value = samples[button.dataset.sample]; });
  });

  // App Bridge が Authorization: Bearer <セッショントークン> を自動で付けてくれる
  document.getElementById("run").addEventListener("click", async () => {
    resultEl.textContent = "実行中...";
    const response = await fetch("/api/graphql", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ query: queryEl.value }),
    });
    resultEl.textContent = JSON.stringify(await response.json(), null, 2);
    reloadLogs();
  });

  const escape = (value) => String(value ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

  async function reloadLogs() {
    const logs = await (await fetch("/api/logs")).json();
    document.getElementById("logs").innerHTML = logs.map((log) => `
      <tr>
        <td>${log.id}</td>
        <td>${new Date(log.created_at).toLocaleTimeString()}</td>
        <td>${log.direction === "inbound" ? "← in" : "→ out"}</td>
        <td>${escape(log.category)}</td>
        <td>${escape(log.http_method)}</td>
        <td class="url">${escape(log.url.slice(0, 100))}</td>
        <td>${escape(log.status ?? log.error)}</td>
        <td>${escape(log.duration_ms)}</td>
      </tr>`).join("");
  }
  document.getElementById("reload-logs").addEventListener("click", reloadLogs);
  const migrateBox = document.getElementById("migrate-box");
  if (migrateBox) {
    const migrateButton = document.getElementById("migrate");
    const ack = document.getElementById("migrate-ack");
    const migrateResult = document.getElementById("migrate-result");

    // 無期限なら通常の移行、有期限なら検証用に force=1 で移行リクエストをそのまま送る
    const render = () => {
      const expiring = migrateBox.dataset.expiring === "true";
      document.getElementById("migrate-note").textContent = expiring
        ? "検証用: 有期限トークンのまま移行リクエストを Shopify に送ります（成功した場合は返ってきたトークンで保存し直します）。"
        : "有期限トークンへの移行は元に戻せません（今の無期限トークンは失効します）。";
      document.getElementById("migrate-ack-label").textContent = expiring ? "検証用に送信する" : "元に戻せないことを理解した";
      migrateButton.textContent = expiring ? "有期限トークンで移行リクエストを送る" : "有期限トークンに移行";
      ack.checked = false;
      migrateButton.disabled = true;
    };
    render();

    ack.addEventListener("change", () => { migrateButton.disabled = !ack.checked; });
    migrateButton.addEventListener("click", async () => {
      migrateButton.disabled = true;
      migrateResult.hidden = false;
      migrateResult.textContent = "送信中...";
      const force = migrateBox.dataset.expiring === "true";
      const response = await fetch("/api/token/migrate_to_expiring", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ force }),
      });
      const data = await response.json();
      migrateResult.textContent = JSON.stringify(data, null, 2);
      if (response.ok) {
        document.getElementById("token-kind").textContent = "有期限";
        document.getElementById("token-expires").textContent = new Date(data.expires_at).toLocaleString();
        document.getElementById("token-refresh-expires").textContent = data.refresh_token_expires_at ? new Date(data.refresh_token_expires_at).toLocaleString() : "-";
        migrateBox.dataset.expiring = "true";
      }
      render();
      reloadLogs();
    });
  }
</script>
